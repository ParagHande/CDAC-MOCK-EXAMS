      "question": "What is the time and space complexity of the following memoised Fibonacci?",
      "snippetLines": [
        "Map<Integer,Long> memo = new HashMap<>();",
        "public long fib(int n) {",
        "    if (n <= 1) return n;",
        "    if (memo.containsKey(n)) return memo.get(n);",
        "    long result = fib(n-1) + fib(n-2);",
        "    memo.put(n, result);",
        "    return result;",
        "}"
      ],
